# Modèle de configuration du frontend T-Express.
# Copier ce fichier en `.env` (ignoré par Git) et ajuster les valeurs.
# Toutes les variables doivent être préfixées `NEXT_PUBLIC_` pour être lisibles
# côté navigateur — n'y mettre donc aucun secret.

# --- API backend -------------------------------------------------------------
# URL de base de l'API Laravel, suffixe `/api` inclus.
# En local : http://127.0.0.1:8000/api — en production, la valeur doit être
# fournie par la plateforme d'hébergement, pas par un `.env` du dépôt.
# Sert aussi à autoriser le domaine des images dans `next.config.js`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Délai d'expiration des requêtes API, en millisecondes (défaut : 5000).
NEXT_PUBLIC_API_TIMEOUT=30000

# --- Upload d'images (admin) -------------------------------------------------
# Taille maximale d'un fichier, en octets (défaut : 5242880, soit 5 Mo).
NEXT_PUBLIC_MAX_FILE_SIZE=5242880

# Types MIME acceptés, séparés par des virgules.
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Paiement ----------------------------------------------------------------
# Le paiement en ligne Wave a été retiré (ticket #2) : les commandes sont
# finalisées sur WhatsApp avec l'admin (voir `src/lib/whatsapp.ts`, numéro codé
# dans le code et non dans l'environnement). Laisser `false`.
# Ces deux variables ne sont plus lues que par `PAYMENT_CONFIG`
# (`src/config/api.config.ts`), qui disparaîtra avec le ticket #3.
NEXT_PUBLIC_ENABLE_WAVE=false
NEXT_PUBLIC_WAVE_API_URL=

# --- Variables historiques, plus lues par le code ----------------------------
# L'ancien `.env` définissait aussi NEXT_PUBLIC_LOCALE, NEXT_PUBLIC_CURRENCY,
# NEXT_PUBLIC_CURRENCY_SYMBOL, NEXT_PUBLIC_PHONE_PREFIX, NEXT_PUBLIC_ADMIN_ROUTE,
# NEXT_PUBLIC_ENABLE_ADMIN, NEXT_PUBLIC_APP_NAME, NEXT_PUBLIC_APP_DESCRIPTION,
# NEXT_PUBLIC_ORANGE_MONEY_API_URL et NEXT_PUBLIC_ENABLE_ORANGE_MONEY.
# Aucune n'est utilisée : ne pas les recopier. Ces valeurs sont aujourd'hui
# en dur dans le code (`LOCALE_CONFIG` dans `src/config/api.config.ts`, `src/config/site.ts`,
# et les métadonnées des pages).
